{
  "name": "student-progress-reports",
  "private": true,
  "version": "1.0.0",
  "description": "Student Progress Reports App for Nava Bharath National School",
  "author": "Nava Bharath National School",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && gh-pages -d dist",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:exe": "vite build && electron-packager . \"Student Progress Reports\" --platform=win32 --arch=x64 --out=dist-app --overwrite"
  },
  "build": {
    "appId": "com.nbns.progressreports",
    "productName": "Student Progress Reports",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "logo/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "vite": "^5.0.8"
  }
}
